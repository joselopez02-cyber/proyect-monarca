# Copia este archivo a .env y ajusta los valores
PORT=8080
DATABASE_URL=postgres://postgres:monarca@localhost:5432/cinema_monarca
# Pon true solo si usas una base en la nube que exige SSL (por ejemplo Aiven)
DB_SSL=false
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Orígenes externos permitidos por CORS (el propio dominio de la app siempre se acepta)
CORS_ORIGINS=http://localhost:5173
# Límite global de peticiones por IP (opcional)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
