{
  "name": "monarca-backend",
  "version": "1.0.0",
  "description": "API de Cinema Monarca (Node.js + Express + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "c8 --reporter=text --include=src/utils/pagoService.js --include=src/utils/reservas.js --include=src/utils/sillas.js --include=src/middleware/validar.js --include=src/utils/validators.js node --test ./tests/unit/backend.test.js",
    "test:integration": "node ./tests/integration/run.js",
    "test:performance": "node ./tests/performance/run.js",
    "test:performance:ht12": "node ./tests/performance/run.js ht12",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --reset",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:migrate:status": "node scripts/migrate.js status"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
